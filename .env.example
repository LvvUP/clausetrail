# 复制为 .env 后填写（.env 已在 .gitignore 里，不要提交）。
# 留空的密钥对应的组件会在 /api/health 里显示为不可用，提问时返回 model_unavailable。
# 不想调用任何外部服务时，把三个 *_BACKEND 都设为 fake，可以离线跑通全链路（结果仅作示例）。

# ---- 向量模型：bge-m3，部署在阿里云 PAI-EAS（OpenAI 兼容 /v1/embeddings）----
EMBEDDER_BACKEND=aliyun_pai_eas
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# EAS 服务的访问地址，形如 http://<service>.<region>.pai-eas.aliyuncs.com/api/predict/<service>
ALIYUN_PAI_EAS_URL=
ALIYUN_PAI_EAS_TOKEN=

# ---- 精排：OpenSearch AI 搜索开放平台 ops-bge-reranker-larger ----
RERANKER_BACKEND=aliyun_opensearch
# 控制台「API-KEY 管理」页显示的公网或 VPC 地址，形如 http://<instance>.platform-cn-shanghai.opensearch.aliyuncs.com
ALIYUN_OPENSEARCH_HOST=
ALIYUN_OPENSEARCH_API_KEY=
ALIYUN_OPENSEARCH_WORKSPACE=default
ALIYUN_OPENSEARCH_RANKER_ID=ops-bge-reranker-larger
# 服务限制 query + doc 不超过 512 token，超出部分在发送前截断
RERANKER_MAX_TOKENS=512

# ---- 大模型：阿里云百炼 Qwen（OpenAI 兼容模式）----
LLM_BACKEND=aliyun_bailian
ALIYUN_BAILIAN_API_KEY=
ALIYUN_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 改写用轻量模型，回答用强模型；模型名以百炼控制台列出的为准
LLM_REWRITE_MODEL=qwen-flash
LLM_ANSWER_MODEL=qwen-plus

# ---- 本地模型（*_BACKEND=local 时使用，权重用 make models LOCAL=1 下载）----
# 默认 ~/.cache/clausetrail/models，需要改时写绝对路径
# LOCAL_MODEL_DIR=/absolute/path/to/models
# 是否用 FP16：auto（默认，检测到 CUDA GPU 时开启）/ true / false。CPU 上 FP16 反而更慢
# LOCAL_MODEL_FP16=auto

# ---- 向量库：Milvus Lite 本地文件；连 Milvus standalone 时改成 http://localhost:19530 ----
# 默认 data/milvus.db
# VECTOR_STORE_URI=http://localhost:19530
VECTOR_COLLECTION=clause_chunks

# ---- BM25：Elasticsearch（docker compose --profile search up -d）----
# 连不上 ES 时自动改用 Milvus 内置 BM25，并在 /api/health 里标出降级
BM25_BACKEND=es
ES_URL=http://localhost:9200
ES_INDEX=clause_chunks
ES_USERNAME=
ES_PASSWORD=

# ---- 查询缓存：Redis；留空则用进程内 LRU ----
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=86400

# ---- 检索与拒答 ----
RECALL_TOP_K=50
RRF_K=60
RERANK_TOP_K=20
CONTEXT_TOP_K=5
# 拒答阈值：精排最高分低于它时直接拒答；用 eval 在开发集上标定（eval/reports/calibration.json）
REFUSAL_THRESHOLD=0.35

# ---- 解析 ----
# 关闭后不跑 DeepDoc 版面模型，速度快，但无边框表格识别不到
LAYOUT_ANALYSIS=true

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
# CORS_ORIGINS=["http://localhost:5173"]
# 只接受这些 Host 头（不含端口），防 DNS rebinding；放到反向代理后面时加上对外域名。IPv6 地址要带方括号
# ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]

# DeepDoc 模型目录只从 shell 环境变量读取（默认 ~/.cache/clausetrail/deepdoc）：
#   export DEEPDOC_MODEL_DIR=/absolute/path
